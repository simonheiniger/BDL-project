pragma solidity ^0.8.24;

/// @title SpriteExtras – Eierschale, Cosmetics (Item-IDs 1..5), Aura
contract SpriteExtras {
    /// @dev 32x14 ab Zeile 18
    function shell() external pure returns (bytes memory) {
        return hex"";
    }

    /// @dev 32x32; 1 Zylinder, 2 Sonnenbrille, 3 Krone, 4 Schal, 5 Fluegel (hinter dem Koerper)
    function cosmetic(uint256 i) external pure returns (bytes memory) {
        if (i == 0) return hex"";
        if (i == 1) return hex"";
        if (i == 2) return hex"";
        if (i == 3) return hex"";
        if (i == 4) return hex"";
        if (i == 5) return hex"";
        return "";
    }

    /// @dev 32x32 Ring fuer legendaere Pets
    function aura() external pure returns (bytes memory) {
        return hex"";
    }
}
